{
  "name": "lincoln-install",
  "version": "1.5.5",
  "description": "Terminal TUI installer for the Lincoln AI-Native R&D workflow system",
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "lincoln-install": "dist/main.js",
    "lincoln-update": "dist/update-main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "echo 'lint not configured'"
  },
  "dependencies": {
    "ink": "^5.2.0",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/tar": "^6.1.13",
    "@vitest/coverage-v8": "^4.1.10",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "lincoln",
    "installer",
    "tui",
    "claude-code",
    "ai-workflow"
  ],
  "license": "MIT"
}
