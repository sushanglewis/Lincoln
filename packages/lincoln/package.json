{
  "name": "@sushanglewis/lincoln",
  "version": "1.5.0",
  "description": "Global Lincoln agent harness plugin CLI",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lincoln": "./dist/main.js",
    "lincoln-install": "./dist/main.js",
    "lincoln-update": "./dist/main.js"
  },
  "files": [
    "dist",
    "framework"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "echo 'lint not configured'",
    "prepack": "npm run build && node ../../scripts/sync-framework-package.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "lincoln",
    "agent-harness",
    "claude-code",
    "codex",
    "opencode",
    "plugin"
  ],
  "license": "MIT"
}
