{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lincoln-framework.dev/schemas/prd-traceability.schema.json",
  "title": "Lincoln PRD Traceability Sidecar",
  "description": "Structured relationships for a narrative PRD. Stage-specific completeness is enforced by scripts/lincoln_traceability.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "prd_version", "requirements"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "prd_version": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+$"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/requirement"
      }
    }
  },
  "definitions": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "core",
        "sources",
        "story_ids",
        "acceptance_criterion_ids",
        "flow_step_ids",
        "prototype_pages",
        "test_scenario_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/requirementId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source"
          }
        },
        "story_ids": {
          "$ref": "#/definitions/storyIds"
        },
        "acceptance_criterion_ids": {
          "$ref": "#/definitions/acceptanceCriterionIds"
        },
        "flow_step_ids": {
          "$ref": "#/definitions/flowStepIds"
        },
        "prototype_pages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^pages/prototype/[^\\\\]+\\.html$"
          }
        },
        "test_scenario_ids": {
          "$ref": "#/definitions/testScenarioIds"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SRC-[A-Z0-9][A-Z0-9_-]*$"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirementId": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9][A-Z0-9_-]*$"
    },
    "storyIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^US-[A-Z0-9][A-Z0-9_-]*$"
      }
    },
    "acceptanceCriterionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[A-Z0-9][A-Z0-9_-]*$"
      }
    },
    "flowStepIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^FLOW-[A-Z0-9][A-Z0-9_-]*$"
      }
    },
    "testScenarioIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TEST-[A-Z0-9][A-Z0-9_-]*$"
      }
    }
  }
}
