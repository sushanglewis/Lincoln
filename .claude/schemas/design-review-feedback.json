{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Review Feedback",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "summary"],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "summary": {
            "type": "string",
            "maxLength": 500
          },
          "file": {
            "type": "string"
          },
          "recommendation": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}